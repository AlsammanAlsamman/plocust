{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "A flanking sequence that locates the locus on any assembly by alignment.\n\n`variant_offset` marks the position the anchor stands for: the lead\nvariant, a block edge, or the centre of a gene anchor.",
      "properties": {
        "role": {
          "$ref": "#/$defs/AnchorRole"
        },
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "variant_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based index of the variant inside `sequence` (lead_snp only)",
          "title": "Variant Offset"
        },
        "unique": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "maps once to the source genome; None = not checked",
          "title": "Unique"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. gene ID for a gene anchor",
          "title": "Label"
        }
      },
      "required": [
        "role",
        "sequence"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "AnchorRole": {
      "enum": [
        "lead_snp",
        "block_left",
        "block_right",
        "gene"
      ],
      "title": "AnchorRole",
      "type": "string"
    },
    "CredibleSet": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "description": "e.g. 'wakefield_abf', 'susie'",
          "title": "Method",
          "type": "string"
        },
        "coverage": {
          "default": 0.95,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Coverage",
          "type": "number"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/CredibleVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "method",
        "variants"
      ],
      "title": "CredibleSet",
      "type": "object"
    },
    "CredibleVariant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "pos": {
          "minimum": 1,
          "title": "Pos",
          "type": "integer"
        },
        "pip": {
          "description": "posterior inclusion probability",
          "maximum": 1,
          "minimum": 0,
          "title": "Pip",
          "type": "number"
        }
      },
      "required": [
        "pos",
        "pip"
      ],
      "title": "CredibleVariant",
      "type": "object"
    },
    "FineMapSignal": {
      "additionalProperties": false,
      "description": "One causal signal of the region, with its credible set (most probable variant first).",
      "properties": {
        "log_bf": {
          "title": "Log Bf",
          "type": "number"
        },
        "purity": {
          "description": "min |r| between credible-set variants",
          "maximum": 1,
          "minimum": 0,
          "title": "Purity",
          "type": "number"
        },
        "coverage": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Coverage",
          "type": "number"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/CredibleVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "log_bf",
        "purity",
        "coverage",
        "variants"
      ],
      "title": "FineMapSignal",
      "type": "object"
    },
    "FineMapping": {
      "additionalProperties": false,
      "description": "Multi-signal fine-mapping of the region around the locus (SuSiE from summary statistics + LD).",
      "properties": {
        "method": {
          "description": "e.g. 'susie_rss', 'susie_rss_multi'",
          "title": "Method",
          "type": "string"
        },
        "ld_source": {
          "description": "genotype panel(s) the LD came from, one per population",
          "items": {
            "type": "string"
          },
          "title": "Ld Source",
          "type": "array"
        },
        "region_start": {
          "minimum": 1,
          "title": "Region Start",
          "type": "integer"
        },
        "region_end": {
          "minimum": 1,
          "title": "Region End",
          "type": "integer"
        },
        "n_snps": {
          "minimum": 0,
          "title": "N Snps",
          "type": "integer"
        },
        "max_signals": {
          "minimum": 1,
          "title": "Max Signals",
          "type": "integer"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "ld_outliers": {
          "default": 0,
          "description": "SNPs whose z does not fit the LD (|residual| > 4)",
          "minimum": 0,
          "title": "Ld Outliers",
          "type": "integer"
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FineMapSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "lead_signal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "index of the signal this locus's lead belongs to",
          "title": "Lead Signal"
        }
      },
      "required": [
        "method",
        "ld_source",
        "region_start",
        "region_end",
        "n_snps",
        "max_signals",
        "converged"
      ],
      "title": "FineMapping",
      "type": "object"
    },
    "Gene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "distance_bp": {
          "description": "0 when the gene overlaps the lead or credible set",
          "minimum": 0,
          "title": "Distance Bp",
          "type": "integer"
        },
        "in_credible_set": {
          "default": false,
          "title": "In Credible Set",
          "type": "boolean"
        },
        "annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "distance_bp"
      ],
      "title": "Gene",
      "type": "object"
    },
    "Imprint": {
      "additionalProperties": false,
      "description": "The locus's surroundings as seen in the GWAS summary statistics of the source study.\n\n`pos`, `ids`, `ref`, `alt`, `z` are parallel lists for every tested SNP within\n+- window_bp of the lead (source build). `z` is signed for the alt allele when the\nstudy reports effects (`z_signed`), otherwise |z| from the p-value.\n`profile` is the max |z| in `bins` equal bins across the window, centred on the\nlead: a fixed-length shape that can be compared between studies.\n`ld_edges` links the top significant SNPs (indices into the lists) with r2 >= ld_edge_r2.",
      "properties": {
        "window_bp": {
          "minimum": 1,
          "title": "Window Bp",
          "type": "integer"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "z_signed": {
          "title": "Z Signed",
          "type": "boolean"
        },
        "ids": {
          "items": {
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "pos": {
          "items": {
            "type": "integer"
          },
          "title": "Pos",
          "type": "array"
        },
        "ref": {
          "items": {
            "type": "string"
          },
          "title": "Ref",
          "type": "array"
        },
        "alt": {
          "items": {
            "type": "string"
          },
          "title": "Alt",
          "type": "array"
        },
        "z": {
          "items": {
            "type": "number"
          },
          "title": "Z",
          "type": "array"
        },
        "bins": {
          "title": "Bins",
          "type": "integer"
        },
        "profile": {
          "items": {
            "type": "number"
          },
          "title": "Profile",
          "type": "array"
        },
        "half_max_width_bp": {
          "description": "span of SNPs with -log10 p >= half the lead's",
          "minimum": 0,
          "title": "Half Max Width Bp",
          "type": "integer"
        },
        "n_significant": {
          "minimum": 0,
          "title": "N Significant",
          "type": "integer"
        },
        "independent_signals": {
          "description": "loci of this study within the window, this one included",
          "minimum": 1,
          "title": "Independent Signals",
          "type": "integer"
        },
        "ld_edge_r2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ld Edge R2"
        },
        "ld_edges": {
          "default": [],
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Ld Edges",
          "type": "array"
        },
        "territory_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "this locus's own part of the window: halfway to the neighbouring leads of the same study (source build)",
          "title": "Territory Start"
        },
        "territory_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Territory End"
        }
      },
      "required": [
        "window_bp",
        "threshold",
        "z_signed",
        "ids",
        "pos",
        "ref",
        "alt",
        "z",
        "bins",
        "profile",
        "half_max_width_bp",
        "n_significant",
        "independent_signals"
      ],
      "title": "Imprint",
      "type": "object"
    },
    "LDBlock": {
      "additionalProperties": false,
      "description": "LD around the lead in the source panel. Panel-specific by nature.",
      "properties": {
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "method": {
          "description": "e.g. 'r2>=0.6 from lead', 'gabriel'",
          "title": "Method",
          "type": "string"
        },
        "r2_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "R2 Threshold"
        },
        "n_haplotypes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Haplotypes"
        },
        "haplotype_freqs": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Haplotype Freqs",
          "type": "array"
        },
        "inversion_like": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "long block with near-perfect LD",
          "title": "Inversion Like"
        }
      },
      "required": [
        "start",
        "end",
        "method"
      ],
      "title": "LDBlock",
      "type": "object"
    },
    "LocusKind": {
      "enum": [
        "gwas",
        "gene",
        "qtl",
        "eqtl"
      ],
      "title": "LocusKind",
      "type": "string"
    },
    "Neighbour": {
      "additionalProperties": false,
      "properties": {
        "passport_id": {
          "title": "Passport Id",
          "type": "string"
        },
        "distance_bp": {
          "minimum": 0,
          "title": "Distance Bp",
          "type": "integer"
        },
        "r2_with_lead": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "R2 With Lead"
        },
        "independent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent"
        }
      },
      "required": [
        "passport_id",
        "distance_bp"
      ],
      "title": "Neighbour",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "Where the locus sits on one genome build. Derived from anchors, never the identity.",
      "properties": {
        "build": {
          "title": "Build",
          "type": "string"
        },
        "chrom": {
          "title": "Chrom",
          "type": "string"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "strand": {
          "default": "+",
          "pattern": "^[+-]$",
          "title": "Strand",
          "type": "string"
        },
        "method": {
          "default": "source",
          "description": "'source' = coordinates from the study; 'anchor' = placed by alignment",
          "title": "Method",
          "type": "string"
        },
        "lead_pos": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "position of the lead variant (or gene anchor centre) on this build",
          "title": "Lead Pos"
        },
        "anchors_placed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchors Placed"
        },
        "anchors_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchors Total"
        },
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlacementFlag"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "build",
        "chrom",
        "start",
        "end"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PlacementFlag": {
      "enum": [
        "missing_anchor",
        "multi_mapping",
        "split",
        "inverted",
        "out_of_order"
      ],
      "title": "PlacementFlag",
      "type": "string"
    },
    "Signal": {
      "additionalProperties": false,
      "description": "The statistical peak, as observed in the source study.",
      "properties": {
        "lead": {
          "$ref": "#/$defs/Variant"
        },
        "effect_allele": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Allele"
        },
        "effect_allele_freq": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Allele Freq"
        },
        "beta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beta"
        },
        "se": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Se"
        },
        "pvalue": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Pvalue",
          "type": "number"
        },
        "peak_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "first position above the threshold",
          "title": "Peak Start"
        },
        "peak_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak End"
        },
        "n_significant": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Significant"
        }
      },
      "required": [
        "lead",
        "pvalue"
      ],
      "title": "Signal",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "study": {
          "title": "Study",
          "type": "string"
        },
        "panel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Panel"
        },
        "n_samples": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Samples"
        },
        "gwas_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gwas Method"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        }
      },
      "required": [
        "study"
      ],
      "title": "Source",
      "type": "object"
    },
    "Trait": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ontology_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. Planteome TO:0000207",
          "title": "Ontology Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "Trait",
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "chrom": {
          "title": "Chrom",
          "type": "string"
        },
        "pos": {
          "minimum": 1,
          "title": "Pos",
          "type": "integer"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "alt": {
          "title": "Alt",
          "type": "string"
        }
      },
      "required": [
        "chrom",
        "pos",
        "ref",
        "alt"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "passport_id": {
      "default": "",
      "title": "Passport Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/LocusKind",
      "default": "gwas"
    },
    "species": {
      "title": "Species",
      "type": "string"
    },
    "trait": {
      "$ref": "#/$defs/Trait"
    },
    "traits_other": {
      "default": [],
      "description": "further traits linked to this locus (pleiotropy)",
      "items": {
        "$ref": "#/$defs/Trait"
      },
      "title": "Traits Other",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "anchors": {
      "items": {
        "$ref": "#/$defs/Anchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "placements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Placement"
      },
      "title": "Placements",
      "type": "array"
    },
    "signal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Signal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "credible_set": {
      "anyOf": [
        {
          "$ref": "#/$defs/CredibleSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ld_block": {
      "anyOf": [
        {
          "$ref": "#/$defs/LDBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "imprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Imprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fine_mapping": {
      "anyOf": [
        {
          "$ref": "#/$defs/FineMapping"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "genes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gene"
      },
      "title": "Genes",
      "type": "array"
    },
    "neighbours": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Neighbour"
      },
